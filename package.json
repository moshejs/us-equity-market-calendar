{
  "name": "us-equity-market-calendar",
  "version": "2.0.1",
  "description": "NYSE / NASDAQ trading calendar — holidays (incl. Good Friday & Juneteenth), 1pm early closes, trading-day navigation, and DST-aware is-market-open. Algorithmic, zero dependencies.",
  "keywords": [
    "nyse",
    "nasdaq",
    "trading-calendar",
    "market-calendar",
    "market-holidays",
    "trading-days",
    "is-market-open",
    "early-close",
    "stock-market",
    "finance",
    "settlement",
    "stock-market-holidays",
    "nyse-holidays",
    "market-hours",
    "trading-hours",
    "exchange-calendar",
    "business-days",
    "half-day",
    "backtesting",
    "algorithmic-trading",
    "pandas-market-calendars",
    "dst",
    "typescript"
  ],
  "homepage": "https://github.com/moshejs/us-equity-market-calendar#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moshejs/us-equity-market-calendar.git"
  },
  "bugs": {
    "url": "https://github.com/moshejs/us-equity-market-calendar/issues"
  },
  "author": "Moshe Malka <hello@moshemalka.com> (https://moshemalka.com)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
